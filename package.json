{
  "name": "ios-dark-album",
  "version": "2.0.0",
  "private": true,
  "description": "我的相册 - 本地照片/视频浏览（Node.js 服务 + 浏览器，无需 Electron）",
  "author": "My Album",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "start": "node server.js",
    "start:web": "node server.js",
    "check": "node tools/check-syntax.js",
    "test:geometry": "node tools/test-stream-geometry.js",
    "test:stream": "node tools/test-stream.js",
    "test:dom": "node tools/test-stream-dom.js",
    "test:nav": "node tools/test-folder-nav.js",
    "test:live": "node tools/test-live-photo.js",
    "test:cache": "node tools/test-cache.js",
    "test:color": "node tools/test-heic-color.js",
    "test:paths": "node tools/test-install-paths.js",
    "pack": "node tools/pack.js",
    "pack:installer": "node tools/pack.js --installer",
    "pack:verify": "node tools/verify-pack.js",
    "pack:test": "node tools/test-setup.js",
    "release": "node tools/release.js",
    "sign": "node tools/sign.js",
    "test": "node tools/test-stream-geometry.js && node tools/test-stream.js && node tools/test-folder-nav.js && node tools/test-live-photo.js && node tools/test-cache.js && node tools/test-heic-color.js && node tools/test-install-paths.js && node tools/test-stream-dom.js",
    "audit:live": "node tools/audit-live-photos.js",
    "audit:cache": "node tools/audit-cache.js",
    "bench:real": "node tools/bench-real-archive.js",
    "bench:scan": "node tools/bench-scan.js",
    "bench:poll": "node tools/bench-scan.js --client",
    "icon": "node tools/make-icon.js"
  },
  "keywords": [
    "photo-album",
    "windows",
    "heic",
    "local-first"
  ],
  "engines": {
    "node": ">=20.8.1"
  },
  "dependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mp4box": "^2.4.1",
    "sharp": "^0.35.5"
  }
}
