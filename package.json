{
  "name": "ios-dark-album",
  "version": "1.11.0",
  "private": true,
  "description": "我的相册 - Windows 桌面相册，本地读取照片和视频",
  "author": "My Album",
  "license": "MIT",
  "main": "electron/main.js",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "start:web": "node server.js",
    "check": "node tools/check-syntax.js",
    "icon": "node tools/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis --x64"
  },
  "keywords": [
    "electron",
    "photo-album",
    "windows",
    "heic",
    "local-first"
  ],
  "engines": {
    "node": ">=20.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "sharp",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "mp4box": "^2.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  }
}
